---
---

<div class="fig-carousel reveal" role="region" aria-label="Evidence figures carousel">
  <div class="fig-stage">
    <!-- FIG_001 -->
    <figure class="fig-panel is-active" data-index="0" aria-label="FIG_001 Detection pipeline">
      <div class="fig__frame">
        <svg viewBox="0 0 520 200" role="img" aria-labelledby="fig1-title" class="fig-svg">
          <title id="fig1-title">Detection pipeline: telemetry flows through detection engineering into triage and response</title>
          <g fill="none" stroke="currentColor" stroke-width="1.4">
            <rect x="20" y="60" width="110" height="56" rx="10" />
            <text x="75" y="82" text-anchor="middle" class="svg-label">TELEMETRY</text>
            <text x="75" y="100" text-anchor="middle" class="svg-sub">sysmon / edr</text>
            <rect x="145" y="60" width="110" height="56" rx="10" />
            <text x="200" y="82" text-anchor="middle" class="svg-label">DETECT</text>
            <text x="200" y="100" text-anchor="middle" class="svg-sub">sigma · yara</text>
            <rect x="270" y="60" width="110" height="56" rx="10" />
            <text x="325" y="82" text-anchor="middle" class="svg-label">TRIAGE</text>
            <text x="325" y="100" text-anchor="middle" class="svg-sub">tier 1–2</text>
            <rect x="395" y="60" width="110" height="56" rx="10" />
            <text x="450" y="82" text-anchor="middle" class="svg-label">RESPOND</text>
            <text x="450" y="100" text-anchor="middle" class="svg-sub">ir playbook</text>
            <path d="M130 88h12" marker-end="url(#arrow-c1)" />
            <path d="M255 88h12" marker-end="url(#arrow-c1)" />
            <path d="M380 88h12" marker-end="url(#arrow-c1)" />
            <defs><marker id="arrow-c1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="currentColor" stroke="none" /></marker></defs>
            <path d="M75 116v28h370v-22" marker-end="url(#arrow-c1)" stroke-dasharray="4 4" />
            <text x="260" y="160" text-anchor="middle" class="svg-sub">feedback loop — every incident hardens the next detection</text>
          </g>
        </svg>
      </div>
      <figcaption class="meta-label">FIG_001 · DETECTION PIPELINE telemetry → triage → response</figcaption>
    </figure>

    <!-- FIG_002 -->
    <figure class="fig-panel" data-index="1" aria-label="FIG_002 DFIR workflow">
      <div class="fig__frame">
        <svg viewBox="0 0 520 170" role="img" aria-labelledby="fig2-title" class="fig-svg">
          <title id="fig2-title">DFIR workflow timeline with four phases and evidence artifacts per phase</title>
          <g fill="none" stroke="currentColor" stroke-width="1.4">
            <line x1="20" y1="70" x2="500" y2="70" />
            <circle cx="60" cy="70" r="7" /><circle cx="60" cy="70" r="2.4" fill="currentColor" />
            <text x="60" y="42" text-anchor="middle" class="svg-label">ACQUIRE</text><text x="60" y="100" text-anchor="middle" class="svg-sub">mem · disk · logs</text>
            <circle cx="190" cy="70" r="7" /><circle cx="190" cy="70" r="2.4" fill="currentColor" />
            <text x="190" y="42" text-anchor="middle" class="svg-label">PROCESS</text><text x="190" y="100" text-anchor="middle" class="svg-sub">plaso · kape</text>
            <circle cx="320" cy="70" r="7" /><circle cx="320" cy="70" r="2.4" fill="currentColor" />
            <text x="320" y="42" text-anchor="middle" class="svg-label">ANALYZE</text><text x="320" y="100" text-anchor="middle" class="svg-sub">timeline · iocs</text>
            <circle cx="450" cy="70" r="7" /><circle cx="450" cy="70" r="2.4" fill="currentColor" />
            <text x="450" y="42" text-anchor="middle" class="svg-label">REPORT</text><text x="450" y="100" text-anchor="middle" class="svg-sub">verdict · scope</text>
            <text x="260" y="140" text-anchor="middle" class="svg-sub">chain of custody preserved at every step · UTC-normalized</text>
          </g>
        </svg>
      </div>
      <figcaption class="meta-label">FIG_002 · DFIR WORKFLOW acquire → process → analyze → report</figcaption>
    </figure>

    <!-- FIG_003 -->
    <figure class="fig-panel" data-index="2" aria-label="FIG_003 Incident maturity">
      <div class="fig__frame">
        <svg viewBox="0 0 520 200" role="img" aria-labelledby="fig3-title" class="fig-svg">
          <title id="fig3-title">Incident maturity: flat SOC curve vs steep blue-team learning curve</title>
          <g fill="none" stroke="currentColor" stroke-width="1.2">
            <!-- grid -->
            <g stroke="#e3ded4" stroke-dasharray="2 5" stroke-width="1"><line x1="60" y1="30" x2="60" y2="150" /><line x1="60" y1="150" x2="480" y2="150" /><line x1="60" y1="110" x2="480" y2="110" /><line x1="60" y1="70" x2="480" y2="70" /></g>
            <!-- axes -->
            <line x1="60" y1="30" x2="60" y2="150" stroke="currentColor" stroke-width="1.2" />
            <line x1="60" y1="150" x2="480" y2="150" stroke="currentColor" stroke-width="1.2" />
            <text x="30" y="34" class="svg-sub">high</text><text x="30" y="154" class="svg-sub">low</text>
            <text x="60" y="172" text-anchor="middle" class="svg-sub">hours</text><text x="480" y="172" text-anchor="middle" class="svg-sub">→</text>
            <!-- flat curve -->
            <path d="M70 120 C 180 118, 300 115, 470 110" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" fill="none" />
            <text x="440" y="100" class="svg-label" fill="currentColor" opacity="0.45">flat SOC</text>
            <!-- steep curve -->
            <path d="M70 145 C 140 140, 200 110, 270 85, 350 55, 430 40, 470 38" stroke="var(--accent)" stroke-width="2.4" fill="none" />
            <text x="410" y="32" class="svg-label" fill="var(--accent)">steep blue team</text>
            <!-- rider dot on steep curve -->
            <circle cx="470" cy="38" r="5" fill="var(--accent)" stroke="var(--surface)" stroke-width="2" />
            <!-- area tint -->
            <path d="M70 145 C 140 140, 200 110, 270 85, 350 55, 430 40, 470 38 L 470 150 L 70 150 Z" fill="var(--accent)" opacity="0.06" stroke="none" />
          </g>
        </svg>
      </div>
      <figcaption class="meta-label">FIG_003 · LEARNING CURVE steep teams compound — flat teams repeat</figcaption>
    </figure>
  </div>

  <div class="fig-controls">
    <button class="fig-control" type="button" data-dir="-1" aria-label="Previous figure">← Previous</button>
    <div class="fig-dots" role="tablist" aria-label="Select figure">
      <button class="fig-dot is-active" role="tab" aria-selected="true" aria-label="Figure 1" data-index="0"></button>
      <button class="fig-dot" role="tab" aria-selected="false" aria-label="Figure 2" data-index="1"></button>
      <button class="fig-dot" role="tab" aria-selected="false" aria-label="Figure 3" data-index="2"></button>
    </div>
    <button class="fig-control" type="button" data-dir="1" aria-label="Next figure">Next →</button>
  </div>
</div>

<style>
  .fig-carousel { margin: 0; }
  .fig-stage {
    position: relative;
    min-height: 260px;
    font-weight: 300;
    letter-spacing: 0.02em;
    -webkit-font-smoothing: antialiased;
  }
  .fig-panel { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 280ms ease; margin: 0; }
  .fig-panel.is-active { opacity: 1; pointer-events: auto; position: relative; }
  .fig__frame { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: clamp(16px, 3vw, 28px); margin-bottom: 14px; }
  .fig-svg { width: 100%; height: auto; color: var(--ink); }
  :global(.fig-svg .svg-label) { font-family: var(--mono); font-size: 11px; font-weight: 300; letter-spacing: 0.1em; fill: currentColor; opacity: 0.95; }
  :global(.fig-svg .svg-sub) { font-family: var(--mono); font-size: 10.5px; font-weight: 300; letter-spacing: 0.04em; line-height: 1.45; fill: var(--muted); }
  .fig-controls { display: grid; grid-template-columns: 110px 1fr 110px; align-items: center; gap: 12px; margin-top: 10px; }
  .fig-control { min-height: 38px; padding: 6px 10px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; border-radius: 8px; transition: border-color 140ms ease, color 140ms ease, transform 120ms ease; }
  .fig-control:hover, .fig-control:focus-visible { border-color: var(--accent); color: var(--accent); outline: none; }
  .fig-control:active { transform: scale(0.97); }
  .fig-control:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fig-dots { display: inline-flex; align-items: center; justify-content: center; gap: 2px; }
  .fig-dot { width: 34px; height: 34px; border: 0; background: transparent; cursor: pointer; position: relative; }
  .fig-dot::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: 7px; height: 7px; border: 1px solid var(--accent); background: transparent; transform: translate(-50%, -50%); transition: background 140ms ease; }
  .fig-dot.is-active::after { background: var(--accent); }
  .fig-dot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .fig-panel { transition: none; } }
</style>

<script>
  const panels = Array.from(document.querySelectorAll('.fig-panel'));
  const dots = Array.from(document.querySelectorAll('.fig-dot'));
  const controls = Array.from(document.querySelectorAll('.fig-control'));
  let idx = 0;
  function show(n) {
    idx = (n + panels.length) % panels.length;
    panels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
    dots.forEach((d, i) => {
      d.classList.toggle('is-active', i === idx);
      d.setAttribute('aria-selected', String(i === idx));
    });
  }
  dots.forEach((d) => d.addEventListener('click', () => show(Number(d.getAttribute('data-index')))));
  controls.forEach((c) => c.addEventListener('click', () => show(idx + Number(c.getAttribute('data-dir')))));
  document.addEventListener('keydown', (e) => {
    const host = document.querySelector('.fig-carousel');
    if (!host || !host.contains(document.activeElement)) return;
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>
