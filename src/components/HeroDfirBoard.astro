---
---

<figure class="hero-board">
  <div class="hero-board__head">
    <span>FIG_000 · INCIDENT RESPONSE · NIST 800-61</span>
    <span>6-STEP LIFECYCLE</span>
  </div>
  <div class="hero-board__body">
    <svg viewBox="0 0 360 240" role="img" aria-labelledby="heroBoardTitle" class="hero-board__svg">
      <title id="heroBoardTitle">Incident response lifecycle: preparation through lessons learned</title>
      <!-- paper grid -->
      <g fill="none" stroke="var(--paper-rule)" stroke-width="1">
        <line x1="20" y1="120" x2="340" y2="120" />
        <g stroke-dasharray="2 4">
          <line x1="60" y1="60" x2="60" y2="180" />
          <line x1="120" y1="60" x2="120" y2="180" />
          <line x1="180" y1="60" x2="180" y2="180" />
          <line x1="240" y1="60" x2="240" y2="180" />
          <line x1="300" y1="60" x2="300" y2="180" />
        </g>
      </g>
      <!-- connecting backbone -->
      <g fill="none" stroke="var(--blueprint)" stroke-width="1.6">
        <line x1="42" y1="120" x2="328" y2="120" />
        <!-- progress tint up to CONTAIN -->
        <line x1="42" y1="120" x2="160" y2="120" stroke="var(--blueprint)" stroke-width="4" stroke-linecap="round" opacity="0.18" />
      </g>
      <!-- step nodes — respaced to fix 5/6 overlap (gap 56) -->
      <g font-family="var(--font-mono)" text-anchor="middle">
        <!-- 1 PREP -->
        <g>
          <circle cx="42" cy="120" r="22" fill="var(--bg-surface)" stroke="var(--ink)" stroke-width="1.4" />
          <text x="42" y="108" font-size="7" letter-spacing="0.08em" fill="var(--ink)">01</text>
          <text x="42" y="123" font-size="8" font-weight="700" fill="var(--ink)">PREP</text>
          <text x="42" y="155" font-size="7" fill="var(--ink-mute)">harden</text>
          <text x="42" y="165" font-size="7" fill="var(--ink-mute)">playbooks</text>
        </g>
        <!-- 2 IDENTIFY -->
        <g>
          <circle cx="100" cy="120" r="22" fill="var(--blueprint)" stroke="var(--blueprint)" stroke-width="1.4" />
          <text x="100" y="108" font-size="7" letter-spacing="0.08em" fill="#fff">02</text>
          <text x="100" y="123" font-size="8" font-weight="700" fill="#fff">IDENTIFY</text>
          <text x="100" y="155" font-size="7" fill="var(--ink)">triage</text>
          <text x="100" y="165" font-size="7" fill="var(--ink-mute)">EVTX · EDR</text>
        </g>
        <!-- 3 CONTAIN -->
        <g>
          <circle cx="160" cy="120" r="22" fill="var(--bg-surface)" stroke="var(--blueprint)" stroke-width="1.6" />
          <text x="160" y="108" font-size="7" letter-spacing="0.08em" fill="var(--blueprint)">03</text>
          <text x="160" y="123" font-size="8" font-weight="700" fill="var(--ink)">CONTAIN</text>
          <text x="160" y="155" font-size="7" fill="var(--ink)">isolate</text>
          <text x="160" y="165" font-size="7" fill="var(--ink-mute)">14 hosts</text>
        </g>
        <!-- 4 ERADICATE -->
        <g>
          <circle cx="216" cy="120" r="22" fill="var(--bg-surface)" stroke="var(--ink)" stroke-width="1.4" />
          <text x="216" y="108" font-size="7" letter-spacing="0.08em" fill="var(--ink)">04</text>
          <text x="216" y="123" font-size="8" font-weight="700" fill="var(--ink)">ERADICATE</text>
          <text x="216" y="155" font-size="7" fill="var(--ink-mute)">purge C2</text>
          <text x="216" y="165" font-size="7" fill="var(--ink-mute)">12 IoCs</text>
        </g>
        <!-- 5 RECOVER -->
        <g>
          <circle cx="272" cy="120" r="22" fill="var(--bg-surface)" stroke="var(--ink)" stroke-width="1.4" />
          <text x="272" y="108" font-size="7" letter-spacing="0.08em" fill="var(--ink)">05</text>
          <text x="272" y="123" font-size="8" font-weight="700" fill="var(--ink)">RECOVER</text>
          <text x="272" y="155" font-size="7" fill="var(--ink-mute)">restore</text>
          <text x="272" y="165" font-size="7" fill="var(--ink-mute)">MTTR 2h</text>
        </g>
        <!-- 6 LESSONS — enlarged (was r14 dashed, now r24 solid for balance) -->
        <g>
          <circle cx="328" cy="120" r="24" fill="var(--bg-surface)" stroke="var(--blueprint)" stroke-width="1.6" />
          <text x="328" y="108" font-size="7" letter-spacing="0.08em" fill="var(--blueprint)">06</text>
          <text x="328" y="123" font-size="8" font-weight="700" fill="var(--ink)">LESSONS</text>
          <text x="328" y="155" font-size="7" fill="var(--ink)">hardening</text>
          <text x="328" y="165" font-size="7" fill="var(--ink-mute)">loopback</text>
        </g>
      </g>
      <!-- active pulse on IDENTIFY -->
      <circle cx="100" cy="120" r="28" fill="none" stroke="var(--blueprint)" stroke-width="1" opacity="0.18" stroke-dasharray="2 3" />
      <!-- feedback loop -->
      <g fill="none" stroke="var(--blueprint)" stroke-width="1" opacity="0.35">
        <path d="M328 108 C 336 80, 310 40, 42 40" stroke-dasharray="4 4" marker-end="url(#arrow-ir)" />
      </g>
      <defs>
        <marker id="arrow-ir" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="var(--blueprint)" />
        </marker>
      </defs>
      <!-- loop label -->
      <text x="190" y="34" text-anchor="middle" font-family="var(--font-mono)" font-size="7" letter-spacing="0.1em" fill="var(--blueprint)">FEEDBACK → HARDENING</text>
    </svg>
  </div>
  <figcaption class="hero-board__foot">
    <span class="hero-board__foot-label">NIST 800-61 · ACTIVE: IDENTIFY → CONTAIN</span>
    <span class="hero-board__case">MTTR 2H · IR-2026-04</span>
  </figcaption>
</figure>

<style>
  .hero-board {
    margin: 0;
    border: 1px solid var(--rule-soft);
    background: var(--bg);
    background-image: radial-gradient(var(--paper-rule) 1px, transparent 1px);
    background-size: 16px 16px;
    border-radius: 14px;
    overflow: hidden;
  }
  .hero-board__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .hero-board__head span:first-child { color: var(--blueprint); }
  .hero-board__body { padding: 12px 10px 8px; }
  .hero-board__svg { width: 100%; height: auto; display: block; }
  .hero-board__foot {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    padding: 10px 14px;
    border-top: 1px solid var(--rule-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    background: var(--bg-surface);
  }
  .hero-board__case {
    color: var(--blueprint);
    border: 1px solid var(--blueprint);
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg);
    white-space: nowrap;
  }
</style>
