---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container section">
    <div class="footer__grid">
      <div>
        <span class="meta-label">Colophon</span>
        <p class="footer__pitch">
          The fastest way to reach me is the address below. For incident response or
          consulting work, put <strong>IR</strong> in the subject line — it gets routed first.
        </p>
        <div class="terminal footer__terminal">
          <div class="terminal__bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="terminal__title">contact.sh</span>
            <button class="copy-btn" type="button" data-copy={`echo "${profile.email}" | mailx -s IR -`}>copy</button>
          </div>
          <pre><code><span class="prompt">$</span> echo "{profile.email}" | mailx -s IR -
<span class="dim"># PGP available on request · response &lt; 24h</span></code></pre>
        </div>
      </div>
      <div>
        <span class="meta-label">Elsewhere</span>
        <ul class="footer__links">
          {profile.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target={s.platform === 'email' ? undefined : '_blank'}>
                {s.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      © {year} · {profile.name} · blue team forever · built with astro · zero trackers
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer .section {
    padding-block: 64px 40px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
  }

  .footer__pitch {
    color: var(--muted);
    max-width: 52ch;
    margin-bottom: 24px;
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .footer__links a {
    color: var(--ink);
  }

  .footer__legal {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
