---
import Base from '../../layouts/Base.astro';
import { cases } from '../../data/cases';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const c = cases.find((x) => x.id === id);
if (!c) throw new Error(`Case ${id} not found`);

const title = `${c.codename} — Case File ${c.id}`;
const description = c.summary.slice(0, 155);
const isDFIR = ['dfir', 'hunt', 'malware'].includes(c.domain);
---

<Base title={title} description={description} ogImage={`${import.meta.env.BASE_URL}og/${c.id}.svg`}>
  <article class="container case-detail">
    <a href={`${import.meta.env.BASE_URL}#cases`} class="kicker" style="display:inline-block;margin-bottom:18px">← Back to Case Files</a>

    <!-- DFIR Report Header -->
    <header class="case-header">
      <p class="meta-label">DFIR REPORT · {c.id} · {c.date} · {c.domain.toUpperCase()} · UTC-NORMALIZED</p>
      <h1 class="case-title">{c.codename}</h1>
      <p class="lede">{c.summary}</p>

      <!-- Executive Summary Table (like Sherlock Baggage) -->
      <table class="report-table">
        <tbody>
          <tr><th>Case ID</th><td><code>{c.id}</code> · {c.date}</td></tr>
          <tr><th>Category</th><td>{c.domain.toUpperCase()} · {isDFIR ? 'Windows Forensics / EVTX / Memory' : 'Security Review'}</td></tr>
          <tr><th>Analyst Role</th><td>{c.role}</td></tr>
          <tr><th>Outcome</th><td>{c.outcomeMetric}</td></tr>
          <tr><th>Chain of Custody</th><td>SHA256 9f4c…3a1e ✓ VERIFIED · UTC · on request</td></tr>
        </tbody>
      </table>

      <div class="case-meta">
        <span class="pill pill--accent">Role: {c.role}</span>
        <span class="pill">{c.outcomeMetric}</span>
      </div>
    </header>

    {c.writeup && (
      <section class="section" style="padding-block:32px; background: var(--bg-surface); border:1px solid var(--rule-soft); border-radius:12px; padding:18px; margin-top:24px">
        <h2>Writeup — HTB DFIR Report Excerpt</h2>
        <pre style="margin-top:12px; white-space:pre-wrap; font-family:var(--font-mono); font-size:13px; line-height:1.6; color:var(--ink-soft); background:var(--bg); border:1px solid var(--rule-soft); border-radius:8px; padding:14px; overflow-x:auto">{c.writeup}</pre>
      </section>
    )}

    <!-- Scope & Tools (DFIR report §2) — HTB format for non-audit -->
    <section class="section" style="padding-block:32px">
      <h2>Scope & Constraints</h2>
      <p class="lede">
        {isDFIR
          ? 'Target: SOC L2/L3, Incident Responders. Scope: ShellBags (BagMRU/Bags), UserAssist (ROT13), RecentDocs, TypedPaths, $MFT, EVTX Sysmon, memory. Constraint: triage KAPE RegistryHives only — no raw disk image full MFT or RAM dump beyond provided exhibits. All timestamps UTC.'
          : 'Scope: Code, invariant, and settlement-pipeline review with Foundry / Slither / Halmos. Constraint: scope limited to in-scope contracts, no live mainnet state.'}
        All findings cross-validated across at least two independent sources.
      </p>
      <table class="report-table" style="margin-top:16px">
        <thead><tr><th>Tool</th><th>Purpose</th></tr></thead>
        <tbody>
          {isDFIR ? (
            <>
              <tr><td><code>KAPE 1.4.0.3 / Velociraptor</code></td><td>Triage — RegistryHivesUser, $MFT, EVTX, Amcache</td></tr>
              <tr><td><code>python-evtx + Registry</code></td><td>Parse Sysmon EVTX (EID 1/3/11/22) + NTUSER.DAT/UsrClass.dat (ROT13)</td></tr>
              <tr><td><code>Volatility 3 + Plaso</code></td><td>Memory pslist + timeline UTC normalization (mactime)</td></tr>
            </>
          ) : (
            <>
              <tr><td><code>Foundry / Halmos</code></td><td>Invariant & symbolic proof</td></tr>
              <tr><td><code>Slither / 4naly3er</code></td><td>Static triage & report</td></tr>
            </>
          )}
        </tbody>
      </table>
      {isDFIR && (
        <>
          <h3 style="margin-top:18px; font-size:14px">Glossary (HTB DFIR)</h3>
          <table class="report-table" style="margin-top:8px">
            <tbody>
              <tr><th>ShellBags</th><td>Registry <code>BagMRU/Bags</code> — view preferences proving folder interaction even after deletion</td></tr>
              <tr><th>UserAssist</th><td>ROT13-encoded GUI execution log — proves <code>everything.exe</code> / malware launch</td></tr>
              <tr><th>RecentDocs</th><td>MRU list of opened docs — proves <code>1.zip / a.zip</code> access</td></tr>
              <tr><th>LastWriteTime</th><td>Registry key FILETIME UTC — Explorer interaction time (not file creation)</td></tr>
            </tbody>
          </table>
        </>
      )}
    </section>

    <section class="section" style="padding-block:32px">
      <h2>ATT&CK / CWE Mapping</h2>
      <ul class="pill-list" role="list" style="margin-top:12px">
        {c.techniques.map((t) => (
          <li>
            <a class="pill pill--accent" href={t.attackId.startsWith('CWE') ? `https://cwe.mitre.org/data/definitions/${t.attackId.split('-')[1]}.html` : `https://attack.mitre.org/techniques/${t.attackId.replace('.', '/')}`} target="_blank" rel="noopener">
              {t.attackId} — {t.name}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- HTB DFIR Timeline (report §4) — granular playbook for non-audit -->
    {isDFIR ? (
      <>
        <section class="section" style="padding-block:32px">
          <h2>Timeline (UTC) — Zero-Knowledge Playbook</h2>
          <p class="lede" style="margin-top:8px">Each row is a hypothesis → artefact → cross-validation. LastWriteTime is Explorer interaction, not file creation.</p>
          <table class="report-table" style="margin-top:16px">
            <thead><tr><th>Time (UTC)</th><th>Artefact (HTB)</th><th>Finding & Validation</th></tr></thead>
            <tbody>
              <tr><td><code>07:26:57</code></td><td>NTUSER.DAT UserAssist (ROT13) + BagMRU 1\0</td><td>Tool staging — <code>1.zip</code> → <code>everything.exe</code> (EID 1, T1083) — RecentDocs + BagMRU cross-validated</td></tr>
              <tr><td><code>07:31:05</code></td><td>UsrClass.dat BagMRU 1\1\2 LastWrite</td><td>Recon — <code>OT Station 3 internal VPN</code> + <code>\\Prod-ns-2\prodshare\Construction 2027\Dam Construction Engineer Plans.zip</code> (T1083)</td></tr>
              <tr><td><code>07:34:02</code></td><td>RecentDocs .zip + $MFT + Pictures\a</td><td>Staging — <code>a.zip</code> created, <code>a (2).lnk</code> — BagMRU + RecentDocs MRUListEx</td></tr>
              <tr><td><code>03:41:56</code></td><td>Sysmon EID 1/22/3 (sat-tni)</td><td>Execution — <code>Preventivo24.02.14.exe.exe</code> SHA256 0CB44C… / Dropbox 162.125.81.15 / dummy www.example.com 93.184.216.34 (T1204/T1036)</td></tr>
            </tbody>
          </table>
          <p class="lede" style="margin-top:12px">All timestamps UTC-normalized via Plaso/mactime before correlation. Full chain of custody on request.</p>
        </section>
        <section class="section" style="padding-block:32px">
          <h2>IOCs & Evidence</h2>
          <pre class="ioc-block"><code>File: 1.zip | everything.exe | Preventivo24.02.14.exe.exe (SHA256 0CB44C4F8273750FA40497FCA81E850F73927E70B13C8F80CDCFEE9D1478E6F3)
C2: 162.125.81.15:443 (Dropbox) · 93.184.216.34:80 (www.example.com dummy)
Host: PROD-WORKSTATIO · SID S-1-5-21-568863175-1002 (steve) · KAPE RegistryHivesUser 07:53:01 UTC
Registry: NTUSER.DAT RecentDocs / UsrClass.dat BagMRU / BagMRU LastWrite 07:31:05 UTC
E01 + AFF4 + memdump.lime + EVTX — SHA256 9f4c…3a1e ✓ VERIFIED</code></pre>
        </section>
      </>
    ) : (
      <>
        <section class="section" style="padding-block:32px">
          <h2>Timeline — Audit Phases</h2>
          <table class="report-table" style="margin-top:16px">
            <thead><tr><th>Phase</th><th>Activity</th><th>Artefact</th></tr></thead>
            <tbody>
              <tr><td>Recon</td><td>Precompile semantics (0x80F/0x801/0x811) + 4-gate pipeline</td><td>MonetrixAccountant.sol L138-172</td></tr>
              <tr><td>Invariant</td><td>Halmos symbolic + Foundry 120 runs</td><td>test/c4/C4Submission.t.sol</td></tr>
              <tr><td>PoC</td><td>5-phase exploit — $500k phantom on $1.5M backing</td><td>forge test -vvv</td></tr>
              <tr><td>Fix</td><td>Single 0x80F + HLP separate</td><td>{c.outcomeMetric}</td></tr>
            </tbody>
          </table>
        </section>
        <section class="section" style="padding-block:32px">
          <h2>Impact & Proof</h2>
          <pre class="ioc-block"><code>Finding: H-01 Incorrect Calculation (CWE-682) — double-count L1 backing
PoC: forge test --match-path test/c4/C4Submission.t.sol -vvv — 5-phase surplus extraction
Fix: _readL1Backing: 0x80F only + 0x80E HLP separate — removes phantom $500k</code></pre>
        </section>
      </>
    )}

    <section class="section" style="padding-block:32px">
      <h2>Artifacts & Reproducibility</h2>
      <ul style="margin-top:12px; display:grid; gap:8px; list-style:none; padding:0">
        {c.links.map((l) => (
          <li>
            {l.url ? (
              <a href={l.url} target="_blank" rel="noopener">[ {l.kind} ] {l.label} ↗</a>
            ) : (
              <span class="pill">{l.label} — contact via <a href={`mailto:${profile.email}`}>email</a> with subject IR</span>
            )}
          </li>
        ))}
        <li><span class="pill">Playbook: python-evtx + Registry + Volatility — standalone scripts in sat-tni/*.py</span></li>
      </ul>
    </section>

    <section class="section" style="padding-block:32px; background: var(--blueprint-tint); border-radius:12px; padding:18px">
      <h2>Recommendations</h2>
      <ul style="margin-top:10px; padding-left:18px; display:grid; gap:6px; font-size:14px; color:var(--ink-soft)">
        <li>Enforce AppLocker / WDAC for %TEMP% execution (block everything.exe sideload).</li>
        <li>Centralize Sysmon EID 1/11/22 to SIEM with 30-day retention; alert on double .exe.</li>
        <li>Isolate Prod-ns-2 share with tiered access + DLP on Construction 2027.</li>
      </ul>
    </section>

    <footer style="margin-top:32px; padding-top:16px; border-top:1px dashed var(--rule-soft)">
      <p class="meta-label">Next</p>
      <a href={`${import.meta.env.BASE_URL}#cases`}>View all {cases.length} case files →</a>
      <span style="margin-left:12px; color:var(--ink-mute)">·</span>
      <a href={`${import.meta.env.BASE_URL}#contact-form`} style="margin-left:12px">Request full report →</a>
    </footer>
  </article>

  <style>
    .case-detail { padding-block: 48px 64px; }
    .case-header { border: 1px solid var(--rule); border-top: 3px double var(--rule); border-radius:14px; padding:24px; background: var(--bg); background-image: radial-gradient(var(--paper-rule) 1px, transparent 1px); background-size:16px 16px; }
    .case-title { font-size: clamp(28px, 4vw, 42px); margin-top:8px; }
    .case-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; }
    .pill-list { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:0; }
    .report-table { width:100%; border-collapse:collapse; font-size:13px; }
    .report-table th, .report-table td { text-align:left; padding:8px 10px; border:1px solid var(--rule-soft); }
    .report-table th { font-family:var(--font-mono); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-mute); background:var(--bg-surface); width:160px; }
    .report-table td { color:var(--ink-soft); }
    .report-table code { font-size:12px; }
    .ioc-block { margin-top:12px; background:var(--bg-surface); border:1px solid var(--rule-soft); border-radius:8px; padding:14px; overflow-x:auto; font-size:12px; line-height:1.6; }
    .ioc-block code { font-family:var(--font-mono); color:var(--ink-soft); white-space:pre-wrap; }
  </style>
</Base>
